    "commands": {
      "help": {
        "description": "Lists available commands or details about a command",
        "usage": "help [command]"
      },
      "ls": {
        "description": "Lists directory contents and files",
        "usage": "ls [-la] [path]"
      },
      "cd": {
        "description": "Changes the current working directory in the VFS",
        "usage": "cd [path]"
      },
      "cat": {
        "description": "Concatenates and displays file contents",
        "usage": "cat <file>"
      },
      "pwd": {
        "description": "Prints current working directory",
        "usage": "pwd"
      },
      "clear": {
        "description": "Clears screen command history",
        "usage": "clear"
      },
      "whoami": {
        "description": "Displays current logged-in user information",
        "usage": "whoami"
      },
      "echo": {
        "description": "Prints text to standard output",
        "usage": "echo <text>"
      },
      "date": {
        "description": "Displays current system date and time",
        "usage": "date"
      },
      "header": {
        "description": "Displays styled portfolio banner with color gradient",
        "usage": "header"
      },
      "tree": {
        "description": "Renders visual hierarchical tree of the VFS",
        "usage": "tree [path]"
      },
      "about": {
        "description": "Displays biographical summary and education",
        "usage": "about"
      },
      "projects": {
        "description": "Lists projects or displays project details",
        "usage": "projects [--featured] [--stack=x] [slug]"
      },
      "skills": {
        "description": "Displays technology stack matrix",
        "usage": "skills"
      },
      "certifications": {
        "description": "Lists verified certifications and credentials",
        "usage": "certifications"
      },
      "researches": {
        "description": "Lists academic research papers and awards",
        "usage": "researches"
      },
      "cowsay": {
        "description": "Generates Unix talking cow with customizable message",
        "usage": "cowsay [message]"
      },
      "sudo": {
        "description": "Attempts to execute command as superuser",
        "usage": "sudo <command>"
      },
      "contact": {
        "description": "Displays contact channels and email",
        "usage": "contact"
      },
      "resume": {
        "description": "Triggers resume PDF download",
        "usage": "resume"
      },
      "find": {
        "description": "Searches for files or directories by name",
        "usage": "find <term> [path]"
      },
      "grep": {
        "description": "Searches for text patterns inside files",
        "usage": "grep [-i] <term> [path]"
      },
      "links": {
        "description": "Shows a graph node's links: what it points to and what points to it",
        "usage": "links <id>"
      },
      "theme": {
        "description": "Shows or switches the site theme (dark, light or toggle)",
        "usage": "theme [dark{'|'}light{'|'}toggle]"
      },
      "lang": {
        "description": "Lists the languages or switches the site language",
        "usage": "lang [code]"
      },
      "neofetch": {
        "description": "Shows system info next to the logo",
        "usage": "neofetch"
      },
      "matrix": {
        "description": "Enter the Matrix (Ctrl+C to exit)",
        "usage": "matrix"
      },
      "rm": {
        "description": "Removes files (the system is read-only... almost always)",
        "usage": "rm [-rf] <file>"
      }
